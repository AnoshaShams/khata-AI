# DashScope (Alibaba Cloud Model Studio) — Qwen3.7-Plus handles both OCR (vision)
# and the voice-path text parser, since it's natively vision-language.
DASHSCOPE_API_KEY=your_key_here

# Your dedicated workspace endpoint (from Model Studio > API-Key page — this is
# specific to your account, don't reuse someone else's).
DASHSCOPE_BASE_URL=https://ws-0rbf9b9idg7bqarc.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Confirmed from the Model Studio "Model Code" field on the Qwen3.7-Plus page
# (2026-09-04) — this is the actual API parameter, not a dated snapshot name.
# Free Quota Only is already enabled on this model: 1M tokens, expires 2026/12/03.
QWEN_VL_MODEL=qwen3.7-plus
QWEN_TEXT_MODEL=qwen3.7-plus

# Anosha's track (Audio tab) — not used by ocr.py/parser.py, but kept here so
# the whole team has one shared .env. Qwen-Audio-3.0 family: current, not
# marked Retiring (unlike the Qwen3-ASR/TTS and CosyVoice families).
QWEN_AUDIO_ASR_MODEL=qwen-audio-3.0-asr-flash
QWEN_AUDIO_TTS_MODEL=cosyvoice-v3-plus

# Where the SQLite ledger DB file lives (relative to backend/ when running locally)
DATABASE_URL=sqlite:///./khata.db
