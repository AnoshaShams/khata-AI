# Alibaba Cloud Model Studio — single key, used for all models below
ALIBABA_API_KEY=your_key_here

# Model IDs (passed as the "model" parameter in API calls, not separate keys)
ALIBABA_VISION_MODEL= QWEN_VL_MODEL=qwen3.7-plus      # Mariam's OCR (Qwen2-VL)
ALIBABA_TEXT_MODEL=QWEN_TEXT_MODEL=qwen3.7-plus     # Mariam's transaction parser (Qwen-plus or similar)
ALIBABA_STT_MODEL=qwen-audio-3.0-asr-flash       # Anosha's speech-to-text
ALIBABA_TTS_MODEL=cosyvoice-v3-plus              # Anosha's text-to-speech (daily summary)
